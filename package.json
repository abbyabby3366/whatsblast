{
  "name": "whatsblast",
  "version": "1.0.0",
  "description": "WhatsBlast - WhatsApp Multi-Session Bulk Messaging Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev:server": "nodemon --exec tsx src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm install --legacy-peer-deps && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@whiskeysockets/baileys": "github:JonathanChuahE-Jay/Baileys",
    "baileys": "github:JonathanChuahE-Jay/Baileys",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
